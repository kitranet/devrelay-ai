ENVIRONMENT=production
LOG_LEVEL=INFO
INFERENCE_PROVIDER=mock
NEBIUS_LIVE_INFERENCE_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_TIMEOUT_SECONDS=30
NEBIUS_MAX_OUTPUT_TOKENS=1024
NEBIUS_MAX_PROMPT_TOKENS=6000
NEBIUS_MAX_IN_FLIGHT_REQUESTS=1
NEBIUS_TOTAL_INFERENCE_QUOTA=0
NEBIUS_QUOTA_DB_PATH=/var/lib/devrelay-ai/nebius-quota.sqlite3
AUTHORIZED_REPOSITORIES='{"planning-fixture":"/opt/devrelay-ai/tests/fixtures/planning_repo"}'
ENABLE_LOCAL_REVIEWS=false
ENABLE_ISOLATED_RUNTIME_VALIDATION=false
