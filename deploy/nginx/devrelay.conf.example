# Template only. Replace demo.example.org and certificate paths after the host,
# DNS, and TLS issuer are selected. Only Nginx is exposed by the host firewall.
limit_req_zone $binary_remote_addr zone=devrelay_demo:10m rate=30r/m;

# Reject unknown Host values instead of serving the demo as the default vhost.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name demo.example.org;
    return 301 https://demo.example.org$request_uri;
}

# The default TLS vhost completes TLS with the configured certificate, then
# closes the request for any hostname other than the explicit demo vhost.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/demo.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.org/privkey.pem;
    return 444;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name demo.example.org;

    ssl_certificate /etc/letsencrypt/live/demo.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 16k;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control "private, no-store" always;

    location / {
        limit_req zone=devrelay_demo burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 70s;
        proxy_send_timeout 70s;
    }
}
